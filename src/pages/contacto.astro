---
// src/pages/contacto.astro
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<Layout
  title="Contacto · InmoPremium"
  description="Contáctanos para vender, arrendar o consultar por propiedades en Chile. Respuesta en menos de 24 horas."
>

  <Breadcrumb
    title="Contacto"
    subtitle="Estamos para ayudarte. Escríbenos y te respondemos en menos de 24 horas."
    items={[]}
  />

  <section class="section">
    <div class="container">
      <div class="contact-grid">

        <!-- Formulario -->
        <div class="form-wrap">
          <h2>Envíanos un mensaje</h2>
          <form class="contact-form" id="contact-form">
            <div class="form-row">
              <div class="form-group">
                <label for="nombre">Nombre completo *</label>
                <input type="text" id="nombre" name="nombre" placeholder="Juan Pérez" required />
              </div>
              <div class="form-group">
                <label for="email">Email *</label>
                <input type="email" id="email" name="email" placeholder="juan@email.com" required />
              </div>
            </div>
            <div class="form-group">
              <label for="telefono">Teléfono / WhatsApp</label>
              <input type="tel" id="telefono" name="telefono" placeholder="+56 9 1234 5678" />
            </div>
            <div class="form-group">
              <label for="asunto">Asunto</label>
              <select id="asunto" name="asunto">
                <option value="">Selecciona un motivo</option>
                <option value="compra">Quiero comprar una propiedad</option>
                <option value="arriendo">Quiero arrendar una propiedad</option>
                <option value="vender">Quiero vender mi propiedad</option>
                <option value="tasacion">Solicitar tasación</option>
                <option value="otro">Otro</option>
              </select>
            </div>
            <div class="form-group">
              <label for="mensaje">Mensaje *</label>
              <textarea id="mensaje" name="mensaje" rows={5} placeholder="Cuéntanos en qué podemos ayudarte..." required></textarea>
            </div>
            <button type="submit" class="btn-submit">Enviar mensaje</button>
            <p class="form-note">* Campos obligatorios. Respondemos en menos de 24 horas hábiles.</p>
          </form>
        </div>

        <!-- Info de contacto -->
        <div class="contact-info">
          <h2>Información de contacto</h2>

          <div class="info-items">
            <div class="info-item">
              <div class="info-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92v2z"/></svg>
              </div>
              <div>
                <div class="info-label">Teléfono / WhatsApp</div>
                <a href="https://wa.me/56912345678" target="_blank" rel="noopener" class="info-value">+56 9 1234 5678</a>
              </div>
            </div>

            <div class="info-item">
              <div class="info-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <div class="info-label">Email</div>
                <a href="mailto:contacto@inmopremium.cl" class="info-value">contacto@inmopremium.cl</a>
              </div>
            </div>

            <div class="info-item">
              <div class="info-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <div class="info-label">Cobertura</div>
                <div class="info-value">Todo Chile</div>
              </div>
            </div>

            <div class="info-item">
              <div class="info-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div>
                <div class="info-label">Horario de atención</div>
                <div class="info-value">Lunes a Sábado · 9:00 – 19:00</div>
              </div>
            </div>
          </div>

          <!-- WhatsApp directo -->
          <a
            href="https://wa.me/56912345678?text=Hola, me gustaría obtener más información sobre sus propiedades."
            target="_blank" rel="noopener"
            class="btn-wa"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Escribir por WhatsApp
          </a>
        </div>

      </div>
    </div>
  </section>

</Layout>

<style>
.section { padding: 4rem 0 6rem; background: #F5F0E8; }
.container { max-width: 1280px; margin: 0 auto; padding: 0 3rem; }

.contact-grid {
  display: grid; grid-template-columns: 1fr 420px;
  gap: 4rem; align-items: start;
}

/* Formulario */
.form-wrap h2, .contact-info h2 {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 1.6rem; color: #1A1A1A;
  margin-bottom: 2rem;
}

.contact-form { display: flex; flex-direction: column; gap: 1.2rem; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
.form-group { display: flex; flex-direction: column; gap: .4rem; }
.form-group label {
  font-size: .75rem; font-weight: 600;
  text-transform: uppercase; letter-spacing: .08em; color: #2C2C2C;
}
.form-group input,
.form-group select,
.form-group textarea {
  padding: .75rem 1rem;
  border: 1px solid rgba(26,26,26,.15);
  background: #fff; font-family: 'DM Sans', sans-serif;
  font-size: .92rem; color: #1A1A1A; outline: none;
  transition: border-color .2s;
}
.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus { border-color: #C6A55C; }
.form-group textarea { resize: vertical; }

.btn-submit {
  background: #1A1A1A; color: #F5F0E8;
  padding: .9rem 2rem; font-size: .9rem; font-weight: 600;
  letter-spacing: .05em; text-transform: uppercase;
  border: none; cursor: pointer; transition: background .2s;
  align-self: flex-start;
}
.btn-submit:hover { background: #C6A55C; color: #1A1A1A; }
.form-note { font-size: .75rem; color: #6B6B6B; }

/* Info contacto */
.info-items { display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 2rem; }
.info-item { display: flex; gap: 1.2rem; align-items: flex-start; }
.info-icon {
  width: 44px; height: 44px; flex-shrink: 0;
  background: #E8E4DC; display: flex;
  align-items: center; justify-content: center;
  color: #C6A55C;
}
.info-label {
  font-size: .72rem; text-transform: uppercase;
  letter-spacing: .08em; color: #6B6B6B; margin-bottom: .2rem;
}
.info-value {
  font-size: .95rem; color: #1A1A1A; font-weight: 500;
  text-decoration: none; transition: color .2s;
}
a.info-value:hover { color: #C6A55C; }

.btn-wa {
  display: flex; align-items: center; gap: .7rem; justify-content: center;
  background: #25D366; color: #fff;
  padding: .9rem 1.5rem; font-size: .9rem; font-weight: 600;
  text-decoration: none; transition: background .2s;
  width: 100%;
}
.btn-wa:hover { background: #128C7E; }

@media (max-width: 1024px) {
  .container { padding: 0 1.5rem; }
  .contact-grid { grid-template-columns: 1fr; gap: 3rem; }
}
@media (max-width: 640px) {
  .form-row { grid-template-columns: 1fr; }
}
</style>

---
// src/pages/propiedades/venta.astro
import Layout from '../../layouts/Layout.astro';
import PropCard from '../../components/PropCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getPropiedades } from '../../lib/wp-api.js';

const propiedades = await getPropiedades({
  tipo_operacion: 'venta',
  per_page: 24,
});
---

<Layout
  title="Propiedades en Venta en Chile · InmoPremium"
  description="Encuentra las mejores propiedades en venta en Chile. Casas, departamentos, terrenos y más."
>

  <Breadcrumb
    title="Propiedades en Venta"
    subtitle={`${propiedades.length} propiedad${propiedades.length !== 1 ? 'es' : ''} disponible${propiedades.length !== 1 ? 's' : ''} en venta`}
    items={[{ label: 'Propiedades', href: '/propiedades' }]}
  />

  <section class="section">
    <div class="container">
      {propiedades.length > 0 ? (
        <div class="props-grid">
          {propiedades.map(prop => <PropCard prop={prop} />)}
        </div>
      ) : (
        <div class="empty">
          <div class="empty-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h3>No se encontraron propiedades en venta</h3>
          <p>Intenta con otros filtros o explora todas las propiedades.</p>
          <a href="/propiedades" class="btn-ver-todas">Ver todas las propiedades</a>
        </div>
      )}

    </div>
  </section>

</Layout>

<style>
.section { padding: 2.5rem 0 6rem; background: #F5F0E8; }
.container { max-width: 1280px; margin: 0 auto; padding: 0 3rem; }

.filtros {
  display: flex; align-items: flex-end;
  gap: 1rem; flex-wrap: wrap;
  margin-bottom: 2.5rem;
  padding: 1.5rem;
  background: #EDE8E2;
  border: 1px solid rgba(26,26,26,.1);
}
.filtro-group { display: flex; flex-direction: column; gap: .35rem; }
.filtro-group label {
  font-size: .68rem; font-weight: 600;
  text-transform: uppercase; letter-spacing: .1em; color: #4A5568;
}
.filtro-group select,
.filtro-group input {
  padding: .6rem .9rem;
  border: 1px solid rgba(26,26,26,.15);
  background: #fff;
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: .88rem; outline: none;
  min-width: 160px; color: #111827;
  transition: border-color .2s;
}
.filtro-group select:focus,
.filtro-group input:focus { border-color: #C6A55C; }

.btn-filtrar {
  padding: .65rem 1.6rem;
  background: #111827; color: #F5F0E8;
  border: none; font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: .82rem; font-weight: 600;
  letter-spacing: .04em; text-transform: uppercase;
  cursor: pointer; transition: background .2s;
}
.btn-filtrar:hover { background: #C6A55C; color: #1A1A1A; }
.btn-limpiar {
  padding: .65rem 1rem; color: #4A5568;
  font-size: .82rem; font-weight: 500;
  text-decoration: none;
  border: 1px solid rgba(26,26,26,.15);
  transition: all .2s;
}
.btn-limpiar:hover { border-color: #111827; color: #111827; }

.props-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1.8rem;
}
.empty { text-align: center; padding: 5rem 2rem; }
.empty-icon {
  width: 80px; height: 80px; background: #E8E4DC;
  border-radius: 50%; display: flex; align-items: center;
  justify-content: center; margin: 0 auto 1.5rem; color: #C6A55C;
}
.empty h3 { font-size: 1.2rem; font-weight: 700; color: #111827; margin-bottom: .6rem; }
.empty p { font-size: .9rem; color: #6B7280; margin-bottom: 1.5rem; }
.btn-ver-todas {
  display: inline-block; background: #111827; color: #F5F0E8;
  padding: .75rem 2rem; font-size: .88rem; font-weight: 600;
  text-decoration: none; transition: background .2s;
}
.btn-ver-todas:hover { background: #C6A55C; color: #1A1A1A; }

@media (max-width: 1024px) { .container { padding: 0 1.5rem; } }
@media (max-width: 640px) {
  .filtros { flex-direction: column; }
  .filtro-group select, .filtro-group input { min-width: 100%; }
  .btn-filtrar, .btn-limpiar { width: 100%; text-align: center; }
}
</style>
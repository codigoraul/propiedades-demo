---
// src/components/Footer.astro
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">

    <!-- Col 1: Logo + descripción -->
    <div class="footer-brand">
      <a href="/">
        <img src="/logo-inmopremiun.svg" alt="InmoPremium" class="footer-logo" />
      </a>
      <p class="footer-desc">
        Corredora de propiedades. Venta y arriendo en todo Chile. Atención personalizada y profesional.
      </p>
    </div>

    <!-- Col 2: Propiedades -->
    <div class="footer-col">
      <h4>Propiedades</h4>
      <ul>
        <li><a href="/">Inicio</a></li>
        <li><a href="/propiedades">Todas las propiedades</a></li>
        <li><a href="/propiedades?tipo_operacion=venta">En Venta</a></li>
        <li><a href="/propiedades?tipo_operacion=arriendo">En Arriendo</a></li>
        <li><a href="/nosotros">Nosotros</a></li>
      </ul>
    </div>

    <!-- Col 3: Contacto -->
    <div class="footer-col">
      <h4>Contacto</h4>
      <ul>
        <li>
          <a href="https://wa.me/56912345678" target="_blank" rel="noopener">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
        </li>
        <li>
          <a href="mailto:contacto@inmopremium.cl">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            contacto@inmopremium.cl
          </a>
        </li>
        <li>
          <a href="/contacto">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Formulario de contacto
          </a>
        </li>
      </ul>
    </div>

  </div>

  <div class="footer-bottom">
    <span>© {year} InmoPremium · Todos los derechos reservados</span>
    <a href="#">Política de privacidad</a>
  </div>
</footer>

<style>
.footer { background: #1A1A1A; padding: 4rem 0 0; }

.footer-inner {
  max-width: 1280px; margin: 0 auto;
  padding: 0 3rem 3rem;
  display: grid; grid-template-columns: 2fr 1fr 1fr;
  gap: 3rem;
  border-bottom: 1px solid rgba(255,255,255,.07);
}

.footer-logo { height: 48px; width: auto; margin-bottom: 1.2rem; filter: brightness(0) invert(1); }
.footer-desc {
  font-size: 0.98rem; color: #bcbaba;
  line-height: 1.7; max-width: 280px;
}

.footer-col h4 {
  font-size: .9rem; letter-spacing: .1em; text-transform: uppercase;
  color: rgba(255, 255, 255, 0.863); margin-bottom: 1.2rem;
}
.footer-col ul { list-style: none; display: flex; flex-direction: column; gap: .6rem; }
.footer-col ul li a {
  display: flex; align-items: center; gap: .5rem;
  font-size: .92rem; color: rgb(186, 186, 186);
  text-decoration: none; transition: color .2s;
}
.footer-col ul li a:hover { color: #C6A55C; }
.footer-col ul li a svg { flex-shrink: 0; opacity: .5; }

.footer-bottom {
  max-width: 1280px; margin: 0 auto;
  padding: 1.5rem 3rem;
  display: flex; justify-content: space-between; align-items: center;
  flex-wrap: wrap; gap: .5rem;
  font-size: .92rem; color: rgba(120, 120, 120, 0.877);
}
.footer-bottom a { color: #C6A55C; text-decoration: none; }
.footer-bottom a:hover { text-decoration: underline; }

@media (max-width: 1024px) {
  .footer-inner { grid-template-columns: 1fr 1fr; padding: 0 1.5rem 2.5rem; }
  .footer-bottom { padding: 1.5rem; }
}
@media (max-width: 640px) {
  .footer-inner { grid-template-columns: 1fr; }
  .footer-brand { grid-column: 1; }
}
</style>
